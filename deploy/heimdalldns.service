[Unit]
Description=HeimdallDNS — servidor DNS com filtro
Documentation=https://github.com/ugoneiva/HeimdallDNS
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/heimdalldns -config /etc/heimdalldns/heimdalldns.yaml -data-dir /var/lib/heimdalldns
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

# Roda sem root: só ganha a permissão de abrir a porta 53.
DynamicUser=yes
StateDirectory=heimdalldns
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
